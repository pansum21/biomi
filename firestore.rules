rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{slug} {
      function signedIn() {
        return request.auth != null;
      }

      function ownsCurrent() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
          'slug', 'ownerUid', 'displayName', 'avatarUrl', 'bio', 'location',
          'bioMiId', 'contactEmail', 'links', 'theme', 'published', 'updatedAt'
        ])
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9-]{3,30}$')
        && request.resource.data.ownerUid is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 100000
        && (
          request.resource.data.avatarUrl == ''
          || request.resource.data.avatarUrl.matches('^https://[^ ]+$')
          || request.resource.data.avatarUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')
        )
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 60
        && request.resource.data.bioMiId is string
        && request.resource.data.bioMiId.size() <= 150
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 25
        && request.resource.data.theme is map
        && request.resource.data.theme.keys().hasOnly([
          'a', 'b', 'angle', 'mode', 'style', 'radius', 'buttonColor',
          'iconShape', 'morphism', 'buttonA', 'buttonB', 'buttonAngle',
          'backgroundType', 'backgroundColor', 'backgroundMediaUrl', 'backgroundMediaPath', 'avatarShape', 'avatarRing', 'linkLayout'
        ])
        && request.resource.data.theme.a is string
        && request.resource.data.theme.a.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.theme.b is string
        && request.resource.data.theme.b.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.theme.angle is int
        && request.resource.data.theme.angle >= 0
        && request.resource.data.theme.angle <= 360
        && request.resource.data.theme.mode in ['light', 'dark']
        && request.resource.data.theme.style in ['solid', 'glass', 'outline']
        && request.resource.data.theme.buttonColor in ['auto', 'white', 'dark', 'accent', 'gradient']
        && request.resource.data.theme.iconShape in ['rounded', 'circle']
        && request.resource.data.theme.morphism in [
          'glass', 'water', 'neumorphism', 'clay', 'aurora', 'holo', 'skeuo', 'mix'
        ]
        && request.resource.data.theme.buttonA.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.theme.buttonB.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.theme.buttonAngle is int
        && request.resource.data.theme.buttonAngle >= 0
        && request.resource.data.theme.buttonAngle <= 360
        && request.resource.data.theme.radius in [
          '3px', '9px', '16px', '0px', '4px', '12px', '999px'
        ]
        && request.resource.data.theme.get('backgroundType', 'gradient') in ['solid', 'gradient', 'image', 'video']
        && request.resource.data.theme.get('backgroundColor', '#7057ec') is string
        && request.resource.data.theme.get('backgroundColor', '#7057ec').matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.theme.get('backgroundMediaUrl', '') is string
        && request.resource.data.theme.get('backgroundMediaUrl', '').size() <= 2048
        && (
          request.resource.data.theme.get('backgroundMediaUrl', '') == ''
          || request.resource.data.theme.get('backgroundMediaUrl', '').matches('^https://(firebasestorage\\.googleapis\\.com|storage\\.googleapis\\.com)/[^ ]+$')
        )
        && request.resource.data.theme.get('backgroundMediaPath', '') is string
        && request.resource.data.theme.get('backgroundMediaPath', '').size() <= 300
        && (
          request.resource.data.theme.get('backgroundMediaPath', '') == ''
          || request.resource.data.theme.get('backgroundMediaPath', '').matches('^profile-backgrounds/[^/]+/[a-z0-9-]{3,30}/[A-Za-z0-9._-]+$')
        )
        && request.resource.data.theme.get('avatarShape', 'circle') in ['circle', 'square', 'soft-square']
        && request.resource.data.theme.get('avatarRing', 'none') in ['none', 'blue', 'gradient']
        && request.resource.data.theme.get('linkLayout', 'scroll') in ['scroll', 'slide']
        && request.resource.data.published is bool;
      }

      allow get: if (signedIn() && !exists(/databases/$(database)/documents/profiles/$(slug)))
        || (exists(/databases/$(database)/documents/profiles/$(slug)) && resource.data.published == true)
        || (exists(/databases/$(database)/documents/profiles/$(slug)) && ownsCurrent());
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validProfile();
      allow update: if ownsCurrent()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validProfile();
      allow delete: if ownsCurrent();
    }
  }
}
