rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public BioMi profiles need to display their saved background media.
    // Uploads and deletes are restricted to the authenticated profile owner.
    match /profile-backgrounds/{userId}/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     request.resource == null
                     || (
                       request.resource.size <= 3 * 1024 * 1024
                       && (
                         (
                           request.resource.contentType == 'image/gif'
                           && request.resource.size <= 1536 * 1024
                         )
                         || request.resource.contentType in [
                           'image/jpeg',
                           'image/png',
                           'image/webp',
                           'video/mp4',
                           'video/webm'
                         ]
                       )
                     )
                   );
    }
  }
}
